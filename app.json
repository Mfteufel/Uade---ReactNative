{
  "expo": {
    "name": "Hallado",
    "slug": "hallado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F2F0"
      },
      "package": "com.uade.hallado"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hallado usa tu ubicación para buscar objetos y mascotas cerca tuyo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hallado usa tus fotos para tu foto de perfil y para tus publicaciones.",
          "cameraPermission": "Hallado usa la cámara para tu foto de perfil y para fotografiar lo que perdiste o encontraste."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F2F2F0",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ]
  }
}
