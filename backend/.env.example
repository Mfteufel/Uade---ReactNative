PORT=
DATABASE_URL=
JWT_SECRET=
# Correo por SMTP (Gmail con contraseña de aplicación). Tiene prioridad sobre Brevo. Host/puerto opcionales (smtp.gmail.com / 465).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Alternativa Brevo. MAIL_FROM es opcional con SMTP (por defecto SMTP_USER); obligatorio con Brevo.
BREVO_API_KEY=
MAIL_FROM=
# Base de photoUri; igual a EXPO_PUBLIC_API_URL. USB+adb reverse tcp:3000: http://localhost:3000 | emulador: http://10.0.2.2:3000 | LAN: http://192.168.x.y:3000
PUBLIC_URL=
NODE_ENV=
TRUST_PROXY=
