# Plantilla de entorno de Hallado (modo Neon con archivo privado, o base local instalada a mano).
# Los scripts la copian a backend/.env.demo.local (ignorado por git) si no existe.
# No pongas secretos reales acá: este archivo se commitea.

PORT=3000
# Ejemplo para un Postgres instalado a mano: ajustá usuario, clave, puerto y base.
DATABASE_URL=postgresql://hallado:hallado@localhost:5432/hallado
# Lo completa el script de preparación con un valor aleatorio (32+ caracteres).
JWT_SECRET=
# Lo pone el lanzador según el modo (LAN o USB); tiene que ser alcanzable desde el celular.
PUBLIC_URL=
NODE_ENV=development
TRUST_PROXY=0

# Correo: con SMTP_USER y SMTP_PASS (Gmail con contraseña de aplicación) el código OTP
# llega por mail. Si quedan vacías, el código sale en la consola del backend ([MAIL DEV]).
# Se dejan definidas (vacías) a propósito para que un backend/.env de producción no las pise.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
MAIL_FROM=

# Tests de integración (opcional, solo contra una base local de pruebas).
# Ejemplo: postgresql://hallado:hallado@localhost:5432/hallado_test
TEST_DATABASE_URL=
TEST_DB_ALLOWED_HOST_PREFIX=localhost

# El modo principal usa backend/.env.demo.neon.local, que se recibe en privado y nunca se sube al repo.
# Este archivo (.env.demo.local) aporta el correo y el JWT_SECRET.
